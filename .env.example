# Copy this file to .env.local for local testing. On Vercel, add the same names under
# Project Settings > Environment Variables. NEVER commit real keys to GitHub.

# REQUIRED for chat, videos on any topic, AI quizzes and YouTube notes (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY= 

# Optional
GEMINI_MODEL=gemini-3.8-flash
AI_RATE_PER_MIN=15

# Optional: Google sign-in (see README, step "Google sign-in")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
# Only needed when running locally; Vercel sets it for you
NEXTAUTH_URL=http://localhost:3000
